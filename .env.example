# Server
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# PostgreSQL — remove if using MongoDB only
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=myapp

# MongoDB — remove if using PostgreSQL only
MONGO_URI=mongodb://localhost:27017/myapp

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT — use long random secrets in production (min 32 chars)
JWT_ACCESS_SECRET=change_me_to_a_long_random_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_to_another_long_random_secret_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# OAuth2 — Google (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# CORS
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
