# Test environment — used by Jest integration tests
NODE_ENV=test
PORT=3001
API_PREFIX=/api/v1

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=myapp_test

MONGO_URI=mongodb://localhost:27017/myapp_test

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

JWT_ACCESS_SECRET=test_access_secret_that_is_at_least_32_chars
JWT_REFRESH_SECRET=test_refresh_secret_that_is_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGIN=*
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
